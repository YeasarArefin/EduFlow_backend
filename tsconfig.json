{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@eduflow/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
