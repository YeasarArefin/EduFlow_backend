# Application
NODE_ENV=development
PORT=4000

# Database — local Docker PostgreSQL
DATABASE_URL=postgresql://postgres:eduflow_dev@localhost:5433/eduflow
# Optional direct connection used only by Drizzle migrations. For local development, keep it
# identical to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://postgres:eduflow_dev@localhost:5433/eduflow

# Frontend, CORS, and Better Auth — local browser/API origins
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated allowlist. If omitted, FRONTEND_ORIGIN is the sole allowed origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000

# Better Auth secret — use a unique, cryptographically random value in production.
BETTER_AUTH_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

# Brevo transactional email (required when processing notice batches in production).
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=notices@example.com
BREVO_SENDER_NAME=EduFlow

# SMS provider
SMS_PROVIDER_URL=https://sms-provider.example/send
SMS_PROVIDER_API_KEY=replace-with-provider-api-key

# Production reference (use real values only in Render/Supabase secret management):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# FRONTEND_ORIGIN=https://<vercel-project>.vercel.app
# CORS_ALLOWED_ORIGINS=https://<vercel-project>.vercel.app
# BETTER_AUTH_URL=https://<render-service>.onrender.com
